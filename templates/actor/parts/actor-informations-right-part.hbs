<div class="flexcol stacked-blocks">
  <div class="{{#unless isNpc}}flex0 {{/unless}}stacked-block health-block">
    <h1 class="block-title">
      <label for="char-health-{{actor.id}}">
        {{localize systemFields.attributes.fields.health.label}}
      </label>
    </h1>

    <div class="block-content">
      <div class="block-header-info small-info">
        {{{localize "CF.CharacterSheet.Health.MaxInfo"}}}
        <strong>6</strong>
      </div>

      <div class="block-content-inner u-relative">
        <input type="number" name="system.attributes.health" id="char-health-{{actor.id}}"
               value="{{source.system.attributes.health}}" min="{{systemFields.attributes.fields.health.min}}"
               max="{{systemFields.attributes.fields.health.max}}"
               step="{{systemFields.attributes.fields.health.step}}" class="attribute-input">

        <ul class="small-info">
          <li>
            <strong>{{localize "CF.CharacterSheet.Health.AtValue" value=2}}</strong>
            {{localize "CF.CharacterSheet.Health.WhenAt2"}}
          </li>
          <li>
            <strong>{{localize "CF.CharacterSheet.Health.AtValue" value=1}}</strong>
            {{localize "CF.CharacterSheet.Health.WhenAt1"}}
          </li>
          <li>
            <strong>{{localize "CF.CharacterSheet.Health.AtValue" value=0}}</strong>
            {{localize "CF.CharacterSheet.Health.WhenAt0"}}
          </li>
        </ul>
      </div>
    </div>
  </div>

  {{#unless isNpc}}
    {{> "systems/channel-fear/templates/actor/parts/actor-resources.hbs"}}
  {{/unless}}
</div>
