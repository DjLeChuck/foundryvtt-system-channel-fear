<div class="tab {{tabs.abilities.id}} {{tabs.abilities.cssClass}}" data-group="sheet" data-tab="abilities">
  <div class="abilities">
    <h1 class="block-title top-shadow no-radius">{{localize "CF.Global.Abilities"}}</h1>

    <div class="block-content">
      <div class="block-header-info small-info">
        {{{localize "CF.CharacterSheet.Abilities.MinMaxInfo" min='<strong>1</strong>' max='<strong>6</strong>'}}}
      </div>

      <div class="block-content-inner">
        {{#each system.abilities as |ability key|}}
          <div class="ability flex flex-group-center">
            <input type="text" id="system.abilities.{{key}}" name="system.abilities.{{key}}"
                   value="{{ability}}" />
            <label for="system.abilities.{{key}}">
              {{localize (lookup ../abilitiesList key)}}
            </label>
            <button class="rollable" data-action="roll" data-ability="{{ability}}"
                    data-label="{{localize (lookup ../abilitiesList key)}}">
              <i class="fas fa-dice-d6"></i>
            </button>
          </div>
        {{/each}}

        {{#unless isNpc}}
          <span class="small-info">
            <strong>{{localize "CF.CharacterSheet.Abilities.PointsToSpent"}}</strong>
            {{localize "CF.CharacterSheet.Abilities.PointsCost"}}
          </span>
        {{/unless}}
      </div>
    </div>
  </div>

  <template data-application-part="specialties"></template>
  <template data-application-part="weapons"></template>
</div>
