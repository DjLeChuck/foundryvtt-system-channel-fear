<div class="tab basic-informations flexrow {{tabs.informations.id}} {{tabs.informations.cssClass}}" data-group="sheet"
     data-tab="informations">
  <div class="flex2">
    <div class="flexrow block-content-inner">
      <div class="flex2 informations-container">
        <p class="flex flex-group-center">
          <label for="char-name-{{actor.id}}">{{localize "CF.CharacterSheet.Identity"}}</label>
          {{formInput fields.name id=(concat "char-name-" actor.id) value=source.name}}
        </p>
        {{#if isNpc}}
          <p>
            <label for="char-level-{{actor.id}}">{{localize systemFields.level.label}}</label>
            {{formInput systemFields.level id=(concat "char-level-" actori.id) value=source.system.level localize=true}}
          </p>
        {{/if}}
        {{#unless isNpc}}
          <p class="flex flex-group-center">
            <label for="char-profile-{{actor.id}}">{{localize systemFields.info.fields.profile.label}}</label>
            {{formInput systemFields.info.fields.profile id=(concat "char-profile-" actor.id) name="system.info.profile"
                        value=source.system.info.profile}}
          </p>
        {{/unless}}
        <p>
          <label for="char-keywords-{{actor.id}}">{{localize systemFields.keywords.label}}</label>
          {{formInput systemFields.keywords elementType="textarea" rows=4 id=(concat "char-keywords-" actor.id)
                      classes="autosize" value=source.system.keywords}}
        </p>
        {{#unless isNpc}}
          <p>
            <label for="char-profdef-{{actor.id}}">{{localize systemFields.info.fields.profdef.label}}</label>
            {{formInput systemFields.info.fields.profdef elementType="textarea" rows=6
                        id=(concat "char-profdef-" actor.id) classes="autosize" value=source.system.info.profdef}}
          </p>
        {{/unless}}
      </div>
      {{#if (displayProfileImage)}}
        <div>
          <div class="profile-img-container">
            <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" alt=""
                 title="{{actor.name}}" />
          </div>
        </div>
      {{/if}}
    </div>
  </div>
  <div>{{> "systems/channel-fear/templates/actor/parts/actor-informations-right-part.hbs"}}</div>
</div>
