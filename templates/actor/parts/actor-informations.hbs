<div class="tab basic-informations flexrow {{tabs.informations.id}} {{tabs.informations.cssClass}}" data-group="sheet" data-tab="informations">
  <div class="flex2">
    <div class="flexrow block-content-inner">
      <div class="flex2 informations-container">
        <p class="flex flex-group-center">
          <label for="char-name">{{localize "CF.CharacterSheet.Identity"}}</label>
          {{formInput fields.name id="char-name" value=source.name}}
        </p>
        {{#if isNpc}}
          <p>
            <label for="char-level">{{localize "CF.NpcSheet.Level.Label"}}</label>
            {{formInput systemFields.level id="char-level" value=source.system.level localize=true}}
          </p>
        {{/if}}
        {{#unless isNpc}}
          <p class="flex flex-group-center">
            <label for="char-profile">{{localize "CF.CharacterSheet.Profile"}}</label>
            {{formInput systemFields.info.fields.profile id="char-profile" name="system.info.profile" value=source.system.info.profile}}
          </p>
        {{/unless}}
        <p>
          <label for="char-keywords">{{localize "CF.CharacterSheet.Keywords"}}</label>
          <textarea name="system.keywords" id="char-keywords" rows="4" class="autosize">{{source.system.keywords}}</textarea>
        </p>
        {{#unless isNpc}}
          <p>
            <label for="char-profdef">{{localize "CF.CharacterSheet.ProfDef"}}</label>
            <textarea name="system.info.profdef" id="char-profdef" rows="6" class="autosize">{{source.system.info.profdef}}</textarea>
          </p>
        {{/unless}}
      </div>
      {{#if (displayProfileImage)}}
        <div>
          <div class="profile-img-container">
            <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="" title="{{actor.name}}" />
          </div>
        </div>
      {{/if}}
    </div>
  </div>
  <div>{{> "systems/channel-fear/templates/actor/parts/actor-informations-right-part.hbs"}}</div>
</div>
