<div class="stacked-block resource-block">
  <h1 class="block-title">
    <label for="char-resource-{{actor.id}}">
      {{localize systemFields.attributes.fields.resource.label}}
    </label>
  </h1>

  <div class="block-content">
    <div class="block-header-info small-info">
      {{{localize "CF.CharacterSheet.Resource.MaxInfo"}}}
      <strong>6</strong>
    </div>

    <div class="block-content-inner u-relative">
      <input type="number" name="system.attributes.resource" id="char-resource-{{actor.id}}"
             value="{{source.system.attributes.resource}}" min="{{systemFields.attributes.fields.resource.min}}"
             max="{{systemFields.attributes.fields.resource.max}}"
             step="{{systemFields.attributes.fields.resource.step}}" class="attribute-input">

      <p class="small-info">
        <strong>{{localize "CF.CharacterSheet.Resource.SuccessTitle"}}</strong><br />
        {{localize "CF.CharacterSheet.Resource.SuccessDesc"}}
      </p>
      <p class="small-info">
        <strong>{{localize "CF.CharacterSheet.ProfDef"}}</strong><br />
        {{localize "CF.CharacterSheet.Resource.ProfDefBonusDesc"}}
      </p>
    </div>
  </div>
</div>
